{
  "name": "dsh-video-prompt",
  "version": "0.3.2",
  "private": false,
  "description": "整理 Seedance 2.5 和 Wan3 的中文视频提示词，用图谱、时间线和 Wiki 找灵感，也可以直接让 AI 按需求查参考。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/index.js",
    "data",
    "catalog",
    "wiki",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "docs/LICENSE_AUDIT.md",
    "docs/verified-entries.json",
    "docs/images",
    "docs/marketplace.md"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:data": "python3 scripts/build_catalog.py",
    "test": "npm run build:client && node --test tests/*.test.js",
    "build:client": "node scripts/build_client.mjs"
  },
  "devDependencies": {
    "d3-force": "3.0.1",
    "esbuild": "0.28.1"
  },
  "license": "MIT",
  "author": {
    "name": "benqiwang",
    "url": "https://github.com/mujizi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mujizi/dsh-video-prompt.git"
  },
  "homepage": "https://github.com/mujizi/dsh-video-prompt/blob/main/docs/marketplace.md",
  "bugs": {
    "url": "https://github.com/mujizi/dsh-video-prompt/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "video-prompts",
    "wan3",
    "chinese",
    "knowledge-graph",
    "seedance"
  ]
}
